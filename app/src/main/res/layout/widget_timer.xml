<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/widget_timer_left_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_last_smoke"
            android:textColor="@color/widget_secondary_text_color"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--"
            android:textColor="@color/widget_primary_text_color"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="--"
            android:textColor="@color/widget_accent_color"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_timer_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_widget_resist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/img_cookie_bg_resist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Resist Background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/img_widget_resist_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/action_resisted_craving"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/widget_shield_accent_color" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_widget_quick_add"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/img_cookie_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Quick Add"
                    android:src="@drawable/ic_cigarettebase"
                    android:tint="@color/widget_accent_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+1"
                    android:textColor="@color/widget_accent_color"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
